#version 450
layout(local_size_x=1,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,rgba8) uniform image2D outputImage;
void main() {
    if(gl_GlobalInvocationID.z!=0) return;
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    vec4 value=imageLoad(outputImage,pixel);
    value.b+=float(gl_NumWorkGroups.z)*0.125;
    imageStore(outputImage,pixel,value);
}
