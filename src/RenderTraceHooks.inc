// Included inside the layer exports, with State dispatch helpers in scope.
VKAPI_ATTR void VKAPI_CALL vkCmdSetViewport(VkCommandBuffer c,uint32_t first,uint32_t count,const VkViewport* v){auto s=commandDeviceOf(key(c));if(s->game)for(uint32_t j=0;j<count;++j)argent::trace::record(c,"viewport",{first+j,argent::trace::floatBits(v[j].x),argent::trace::floatBits(v[j].y),argent::trace::floatBits(v[j].width),argent::trace::floatBits(v[j].height)});ARGENT_COMMAND_PROC(s,vkCmdSetViewport)(c,first,count,v);}
VKAPI_ATTR void VKAPI_CALL vkCmdSetScissor(VkCommandBuffer c,uint32_t first,uint32_t count,const VkRect2D* v){auto s=commandDeviceOf(key(c));if(s->game)for(uint32_t j=0;j<count;++j)argent::trace::record(c,"scissor",{first+j,uint64_t(int64_t(v[j].offset.x)),uint64_t(int64_t(v[j].offset.y)),v[j].extent.width,v[j].extent.height});ARGENT_COMMAND_PROC(s,vkCmdSetScissor)(c,first,count,v);}
VKAPI_ATTR VkResult VKAPI_CALL vkAllocateCommandBuffers(VkDevice d,const VkCommandBufferAllocateInfo* ci,VkCommandBuffer* out){auto s=deviceOf(key(d));auto r=s->proc<PFN_vkAllocateCommandBuffers>("vkAllocateCommandBuffers")(d,ci,out);if(r==VK_SUCCESS&&s->game)for(uint32_t i=0;i<ci->commandBufferCount;++i){argent::trace::reset(out[i],ci->commandPool);observeCamera(s,[&](auto& c){c.command(out[i],ci->commandPool);});}return r;}
VKAPI_ATTR void VKAPI_CALL vkFreeCommandBuffers(VkDevice d,VkCommandPool p,uint32_t n,const VkCommandBuffer* c){auto s=deviceOf(key(d));if(s->game)for(uint32_t i=0;i<n;++i){argent::trace::forget(c[i]);observeCamera(s,[&](auto& probe){probe.freeCommand(c[i]);});}s->proc<PFN_vkFreeCommandBuffers>("vkFreeCommandBuffers")(d,p,n,c);}
VKAPI_ATTR VkResult VKAPI_CALL vkBeginCommandBuffer(VkCommandBuffer c,const VkCommandBufferBeginInfo* ci){auto s=commandDeviceOf(key(c));auto r=s->proc<PFN_vkBeginCommandBuffer>("vkBeginCommandBuffer")(c,ci);if(r==VK_SUCCESS&&s->game){argent::trace::reset(c);observeCamera(s,[&](auto& probe){probe.command(c);});if(ci->pInheritanceInfo)argent::trace::record(c,"inherit",{argent::trace::id(ci->pInheritanceInfo->renderPass),argent::trace::id(ci->pInheritanceInfo->framebuffer),ci->pInheritanceInfo->subpass});}return r;}
VKAPI_ATTR VkResult VKAPI_CALL vkResetCommandBuffer(VkCommandBuffer c,VkCommandBufferResetFlags f){auto s=commandDeviceOf(key(c));auto r=s->proc<PFN_vkResetCommandBuffer>("vkResetCommandBuffer")(c,f);if(r==VK_SUCCESS&&s->game)argent::trace::reset(c);observeCamera(s,[&](auto& probe){probe.command(c);});return r;}
VKAPI_ATTR VkResult VKAPI_CALL vkResetCommandPool(VkDevice d,VkCommandPool p,VkCommandPoolResetFlags f){auto s=deviceOf(key(d));auto r=s->proc<PFN_vkResetCommandPool>("vkResetCommandPool")(d,p,f);if(r==VK_SUCCESS&&s->game)argent::trace::resetPool(p);observeCamera(s,[&](auto& probe){probe.resetPool(p,false);});return r;}
VKAPI_ATTR void VKAPI_CALL vkDestroyCommandPool(VkDevice d,VkCommandPool p,const VkAllocationCallbacks* a){auto s=deviceOf(key(d));if(s->game)argent::trace::resetPool(p,true);observeCamera(s,[&](auto& probe){probe.resetPool(p,true);});s->proc<PFN_vkDestroyCommandPool>("vkDestroyCommandPool")(d,p,a);}
VKAPI_ATTR void VKAPI_CALL vkCmdBindPipeline(VkCommandBuffer c,VkPipelineBindPoint b,VkPipeline p){auto s=commandDeviceOf(key(c));observeCamera(s,[&](auto& probe){probe.bindPipeline(c,p,b);});if(s->game)argent::trace::record(c,"pipeline",{uint64_t(b),argent::trace::id(p)});ARGENT_COMMAND_PROC(s,vkCmdBindPipeline)(c,b,p);}
VKAPI_ATTR void VKAPI_CALL vkCmdBeginRenderPass(VkCommandBuffer c,const VkRenderPassBeginInfo* i,VkSubpassContents content){auto s=commandDeviceOf(key(c));if(s->game)argent::trace::record(c,"pass",{argent::trace::id(i->renderPass),argent::trace::id(i->framebuffer),i->renderArea.extent.width,i->renderArea.extent.height,i->clearValueCount,uint64_t(content)});ARGENT_COMMAND_PROC(s,vkCmdBeginRenderPass)(c,i,content);}
VKAPI_ATTR void VKAPI_CALL vkCmdEndRenderPass(VkCommandBuffer c){auto s=commandDeviceOf(key(c));if(s->game)argent::trace::record(c,"end_pass");ARGENT_COMMAND_PROC(s,vkCmdEndRenderPass)(c);}
VKAPI_ATTR void VKAPI_CALL vkCmdNextSubpass(VkCommandBuffer c,VkSubpassContents contents){auto s=commandDeviceOf(key(c));if(s->game)argent::trace::record(c,"next_subpass");ARGENT_COMMAND_PROC(s,vkCmdNextSubpass)(c,contents);}
VKAPI_ATTR void VKAPI_CALL vkCmdDraw(VkCommandBuffer c,uint32_t v,uint32_t i,uint32_t fv,uint32_t fi){auto s=commandDeviceOf(key(c));observeCamera(s,[&](auto& probe){probe.draw(c);});if(s->game)argent::trace::record(c,"draw",{v,i,fv,fi});ARGENT_COMMAND_PROC(s,vkCmdDraw)(c,v,i,fv,fi);}
VKAPI_ATTR void VKAPI_CALL vkCmdDrawIndexed(VkCommandBuffer c,uint32_t n,uint32_t i,uint32_t first,int32_t offset,uint32_t fi){auto s=commandDeviceOf(key(c));observeCamera(s,[&](auto& probe){probe.draw(c);});if(s->game)argent::trace::record(c,"draw_indexed",{n,i,first,uint64_t(int64_t(offset)),fi});ARGENT_COMMAND_PROC(s,vkCmdDrawIndexed)(c,n,i,first,offset,fi);}
VKAPI_ATTR void VKAPI_CALL vkCmdDrawIndirect(VkCommandBuffer c,VkBuffer b,VkDeviceSize o,uint32_t n,uint32_t stride){auto s=commandDeviceOf(key(c));observeCamera(s,[&](auto& probe){probe.draw(c);});if(s->game)argent::trace::record(c,"draw_indirect",{argent::trace::id(b),o,n,stride});ARGENT_COMMAND_PROC(s,vkCmdDrawIndirect)(c,b,o,n,stride);}
VKAPI_ATTR void VKAPI_CALL vkCmdDrawIndexedIndirect(VkCommandBuffer c,VkBuffer b,VkDeviceSize o,uint32_t n,uint32_t stride){auto s=commandDeviceOf(key(c));observeCamera(s,[&](auto& probe){probe.draw(c);});if(s->game)argent::trace::record(c,"draw_indexed_indirect",{argent::trace::id(b),o,n,stride});ARGENT_COMMAND_PROC(s,vkCmdDrawIndexedIndirect)(c,b,o,n,stride);}
VKAPI_ATTR void VKAPI_CALL vkCmdDispatch(VkCommandBuffer c,uint32_t x,uint32_t y,uint32_t z){auto s=commandDeviceOf(key(c));observeCamera(s,[&](auto& probe){probe.dispatch(c);});if(s->game)argent::trace::record(c,"dispatch",{x,y,z});ARGENT_COMMAND_PROC(s,vkCmdDispatch)(c,x,y,z);}
VKAPI_ATTR void VKAPI_CALL vkCmdDispatchIndirect(VkCommandBuffer c,VkBuffer b,VkDeviceSize o){auto s=commandDeviceOf(key(c));observeCamera(s,[&](auto& probe){probe.dispatch(c);});if(s->game)argent::trace::record(c,"dispatch_indirect",{argent::trace::id(b),o});ARGENT_COMMAND_PROC(s,vkCmdDispatchIndirect)(c,b,o);}
VKAPI_ATTR void VKAPI_CALL vkCmdExecuteCommands(VkCommandBuffer c,uint32_t n,const VkCommandBuffer* children){auto s=commandDeviceOf(key(c));if(s->game)for(uint32_t i=0;i<n;++i)argent::trace::record(c,"execute",{argent::trace::id(children[i])});ARGENT_COMMAND_PROC(s,vkCmdExecuteCommands)(c,n,children);}
VKAPI_ATTR VkResult VKAPI_CALL vkCreateImage(VkDevice d,const VkImageCreateInfo* i,const VkAllocationCallbacks* a,VkImage* out){auto s=deviceOf(key(d));auto r=s->proc<PFN_vkCreateImage>("vkCreateImage")(d,i,a,out);if(r==VK_SUCCESS&&s->game)argent::trace::object(d,"image",argent::trace::id(*out),{i->extent.width,i->extent.height,i->extent.depth,uint64_t(i->format),i->arrayLayers,i->usage});return r;}
VKAPI_ATTR VkResult VKAPI_CALL vkCreateImageView(VkDevice d,const VkImageViewCreateInfo* i,const VkAllocationCallbacks* a,VkImageView* out){auto s=deviceOf(key(d));auto r=s->proc<PFN_vkCreateImageView>("vkCreateImageView")(d,i,a,out);if(r==VK_SUCCESS&&s->game)argent::trace::object(d,"view",argent::trace::id(*out),{argent::trace::id(i->image),uint64_t(i->viewType),uint64_t(i->format),i->subresourceRange.baseArrayLayer,i->subresourceRange.layerCount,i->subresourceRange.aspectMask});return r;}
VKAPI_ATTR VkResult VKAPI_CALL vkCreateFramebuffer(VkDevice d,const VkFramebufferCreateInfo* i,const VkAllocationCallbacks* a,VkFramebuffer* out){auto s=deviceOf(key(d));auto r=s->proc<PFN_vkCreateFramebuffer>("vkCreateFramebuffer")(d,i,a,out);if(r==VK_SUCCESS&&s->game){argent::trace::object(d,"framebuffer",argent::trace::id(*out),{argent::trace::id(i->renderPass),i->width,i->height,i->layers,i->attachmentCount,i->flags});if(!(i->flags&VK_FRAMEBUFFER_CREATE_IMAGELESS_BIT))for(uint32_t n=0;n<i->attachmentCount;++n)argent::trace::object(d,"attachment",argent::trace::id(*out),{n,argent::trace::id(i->pAttachments[n])});}return r;}
